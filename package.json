{
  "name": "mulagroup",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node ./scripts/run-turbo.mjs run build",
    "dev": "corepack pnpm --filter @mulagroup/portal dev",
    "dev:all": "node ./scripts/run-turbo.mjs run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node ./scripts/run-turbo.mjs run lint",
    "typecheck": "node ./scripts/run-turbo.mjs run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.1.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.4.0",
    "postcss": "8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "4.2.1",
    "turbo": "2.8.17",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0"
  }
}
